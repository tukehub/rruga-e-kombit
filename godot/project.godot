; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vortex"
config/description="Garë arkade me luftë nëpër qytetet shqiptare."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Data="*res://scripts/data/data.gd"
Settings="*res://scripts/game/settings.gd"
Quality="*res://scripts/game/quality.gd"
Sfx="*res://scripts/game/sfx.gd"
Game="*res://scripts/game/game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=false
sensors/enable_magnetometer=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=1
scaling_3d/scale=1.0
environment/ssao/quality=1
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=64
textures/default_filters/anisotropic_filtering_level=2
mesh_lod/lod_change/threshold_pixels=2.0
occlusion_culling/use_occlusion_culling=false
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=0
limits/time/time_rollover_secs=3600.0
shading/overrides/force_vertex_shading.mobile=false
